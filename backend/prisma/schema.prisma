generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model UserCredentials {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  password  String
  role      String   @default("volunteer")
  createdAt DateTime @default(now())

  // Relation to UserProfile
  profile   UserProfile?
  assignments VolunteerAssignment[]
}

model UserProfile {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         UserCredentials @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  fullName     String
  address      String
  city         String
  state        String
  zipcode      String
  skills       Json     // Array of strings
  preferences  Json     // Array of strings
  availability String   // Comma-separated dates
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model EventDetails {
  id          String       @id @default(uuid())
  name        String
  description String
  location    String
  skills      Json
  urgency     UrgencyLevel @default(low)
  eventDate   DateTime
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  assignments VolunteerAssignment[]
}

enum UrgencyLevel {
  low
  medium
  high
}

enum AssignmentStatus {
  pending
  confirmed
  completed
  cancelled
}

model VolunteerAssignment {
  id           String            @id @default(uuid())
  eventId      String
  volunteerId  String
  status       AssignmentStatus  @default(pending)
  hours        Float             @default(0)
  notes        String?
  assignedAt   DateTime          @default(now())
  completedAt  DateTime?
  updatedAt    DateTime          @updatedAt

  event        EventDetails      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  volunteer    UserCredentials   @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
}
